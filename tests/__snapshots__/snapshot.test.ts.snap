"import type { HttpClient } from "@/shared/api/__generated__/http-client";

import type {
  CreatePetRequestDto,
  ListPetsQueryParams,
  PetDto,
  PetListResponseDto,
  UpdatePetRequestDto,
} from "@/shared/api/__generated__/dto";
import {
  createPetRequestDtoSchema,
  petDtoSchema,
  petListResponseDtoSchema,
  updatePetRequestDtoSchema,
} from "@/shared/api/__generated__/schema";
import { validateSchema } from "@/shared/api/__generated__/utils";

export class PetsApi {
  private readonly httpClient: HttpClient;

  constructor(httpClient: HttpClient) {
    this.httpClient = httpClient;
  }

  /**
   * @tags pets
   * @summary List all pets
   * @request GET:/pets
   */
  async getPets({ params }: TPetsApiRequestParameters["getPets"]) {
    const response = await this.httpClient.request<PetListResponseDto>({
      method: "GET",
      url: \`pets\`,
      query: params,
    });

    const validateResponse = validateSchema(petListResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags pets
   * @summary Create a pet
   * @request POST:/pets
   */
  async postPets({ payload }: TPetsApiRequestParameters["postPets"]) {
    const validatedPayload = validateSchema(createPetRequestDtoSchema, payload);
    const response = await this.httpClient.request<PetDto>({
      method: "POST",
      url: \`pets\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(petDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags pets
   * @summary Get a pet by ID
   * @request GET:/pets/{petId}
   */
  async getPetsByPetId({ petId }: TPetsApiRequestParameters["getPetsByPetId"]) {
    const response = await this.httpClient.request<PetDto>({
      method: "GET",
      url: \`pets/\${petId}\`,
    });

    const validateResponse = validateSchema(petDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags pets
   * @summary Update a pet
   * @request PUT:/pets/{petId}
   */
  async putPetsByPetId({
    petId,
    payload,
  }: TPetsApiRequestParameters["putPetsByPetId"]) {
    const validatedPayload = validateSchema(updatePetRequestDtoSchema, payload);
    const response = await this.httpClient.request<PetDto>({
      method: "PUT",
      url: \`pets/\${petId}\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(petDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags pets
   * @summary Delete a pet
   * @request DELETE:/pets/{petId}
   */
  async deletePetsByPetId({
    petId,
  }: TPetsApiRequestParameters["deletePetsByPetId"]) {
    const response = await this.httpClient.request<void>({
      method: "DELETE",
      url: \`pets/\${petId}\`,
    });

    return response;
  }
}

export type TPetsApiRequestParameters = {
  getPets: {
    params?: ListPetsQueryParams;
  };
  postPets: {
    payload: CreatePetRequestDto;
  };
  getPetsByPetId: {
    petId: number;
  };
  putPetsByPetId: {
    petId: number;
    payload: UpdatePetRequestDto;
  };
  deletePetsByPetId: {
    petId: number;
  };
};
"
`;

