"import type { HttpClient } from "@/shared/api/__generated__/http-client";

import type {
  AuthResponseDto,
  LoginRequestDto,
  RefreshTokenRequestDto,
  SignUpRequestDto,
} from "@/shared/api/__generated__/dto";
import {
  authResponseDtoSchema,
  loginRequestDtoSchema,
  refreshTokenRequestDtoSchema,
  signUpRequestDtoSchema,
} from "@/shared/api/__generated__/schema";
import { validateSchema } from "@/shared/api/__generated__/utils";

export class AuthApi {
  private readonly httpClient: HttpClient;

  constructor(httpClient: HttpClient) {
    this.httpClient = httpClient;
  }

  /**
   * @tags auth
   * @summary Sign Up
   * @request POST:/auth/signup
   */
  async postAuthSignup({
    payload,
  }: TAuthApiRequestParameters["postAuthSignup"]) {
    const validatedPayload = validateSchema(signUpRequestDtoSchema, payload);
    const response = await this.httpClient.request<AuthResponseDto>({
      method: "POST",
      url: \`auth/signup\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(authResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags auth
   * @summary Login
   * @request POST:/auth/login
   */
  async postAuthLogin({ payload }: TAuthApiRequestParameters["postAuthLogin"]) {
    const validatedPayload = validateSchema(loginRequestDtoSchema, payload);
    const response = await this.httpClient.request<AuthResponseDto>({
      method: "POST",
      url: \`auth/login\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(authResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags auth
   * @summary Logout
   * @request POST:/auth/logout
   */
  async postAuthLogout({}: TAuthApiRequestParameters["postAuthLogout"] = {}) {
    const response = await this.httpClient.request<void>({
      method: "POST",
      url: \`auth/logout\`,
    });

    return response;
  }

  /**
   * @tags auth
   * @summary Refresh Token
   * @request POST:/auth/refresh
   */
  async postAuthRefresh({
    payload,
  }: TAuthApiRequestParameters["postAuthRefresh"]) {
    const validatedPayload = validateSchema(
      refreshTokenRequestDtoSchema,
      payload,
    );
    const response = await this.httpClient.request<AuthResponseDto>({
      method: "POST",
      url: \`auth/refresh\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(authResponseDtoSchema, response);
    return validateResponse;
  }
}

export type TAuthApiRequestParameters = {
  postAuthSignup: {
    payload: SignUpRequestDto;
  };
  postAuthLogin: {
    payload: LoginRequestDto;
  };
  postAuthLogout: {};
  postAuthRefresh: {
    payload: RefreshTokenRequestDto;
  };
};
"
`;

exports[`snapshot tests > API code generation > 'ai-chat' - api, apiInstance, dto > ai-chat/api/chats 1`] = `
"import type { HttpClient } from "@/shared/api/__generated__/http-client";

import type {
  ChatCreateRequestDto,
  ChatDetailResponseDto,
  ChatListResponseDto,
  ChatResponseDto,
  ChatUpdateRequestDto,
  GetChatsQueryParams,
  MessageCreateRequestDto,
  MessageListResponseDto,
  StreamStatusResponseDto,
} from "@/shared/api/__generated__/dto";
import {
  chatCreateRequestDtoSchema,
  chatDetailResponseDtoSchema,
  chatListResponseDtoSchema,
  chatResponseDtoSchema,
  chatUpdateRequestDtoSchema,
  messageCreateRequestDtoSchema,
  messageListResponseDtoSchema,
  streamStatusResponseDtoSchema,
} from "@/shared/api/__generated__/schema";
import { validateSchema } from "@/shared/api/__generated__/utils";
import {
  ChatsByChatIdMessagesStreamHandler,
  type ChatsByChatIdMessagesStreamCallbacks,
} from "../../api/stream-handlers";

export class ChatsApi {
  private readonly httpClient: HttpClient;

  constructor(httpClient: HttpClient) {
    this.httpClient = httpClient;
  }

  /**
   * @tags chats
   * @summary Get Chats
   * @request GET:/chats
   */
  async getChats({ params }: TChatsApiRequestParameters["getChats"]) {
    const response = await this.httpClient.request<ChatListResponseDto>({
      method: "GET",
      url: \`chats\`,
      query: params,
    });

    const validateResponse = validateSchema(
      chatListResponseDtoSchema,
      response,
    );
    return validateResponse;
  }

  /**
   * @tags chats
   * @summary Create Chat
   * @request POST:/chats
   */
  async postChats({ payload }: TChatsApiRequestParameters["postChats"]) {
    const validatedPayload = validateSchema(
      chatCreateRequestDtoSchema,
      payload,
    );
    const response = await this.httpClient.request<ChatResponseDto>({
      method: "POST",
      url: \`chats\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(chatResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags chats
   * @summary Get Chat
   * @request GET:/chats/{chatId}
   */
  async getChatsByChatId({
    chatId,
  }: TChatsApiRequestParameters["getChatsByChatId"]) {
    const response = await this.httpClient.request<ChatDetailResponseDto>({
      method: "GET",
      url: \`chats/\${chatId}\`,
    });

    const validateResponse = validateSchema(
      chatDetailResponseDtoSchema,
      response,
    );
    return validateResponse;
  }

  /**
   * @tags chats
   * @summary Update Chat Title
   * @request PATCH:/chats/{chatId}
   */
  async patchChatsByChatId({
    chatId,
    payload,
  }: TChatsApiRequestParameters["patchChatsByChatId"]) {
    const validatedPayload = validateSchema(
      chatUpdateRequestDtoSchema,
      payload,
    );
    const response = await this.httpClient.request<ChatResponseDto>({
      method: "PATCH",
      url: \`chats/\${chatId}\`,
      body: validatedPayload,
    });

    const validateResponse = validateSchema(chatResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags chats
   * @summary Delete Chat
   * @request DELETE:/chats/{chatId}
   */
  async deleteChatsByChatId({
    chatId,
  }: TChatsApiRequestParameters["deleteChatsByChatId"]) {
    const response = await this.httpClient.request<void>({
      method: "DELETE",
      url: \`chats/\${chatId}\`,
    });

    return response;
  }

  /**
   * @tags chats
   * @summary Get Messages
   * @request GET:/chats/{chatId}/messages
   */
  async getChatsByChatIdMessages({
    chatId,
  }: TChatsApiRequestParameters["getChatsByChatIdMessages"]) {
    const response = await this.httpClient.request<MessageListResponseDto>({
      method: "GET",
      url: \`chats/\${chatId}/messages\`,
    });

    const validateResponse = validateSchema(
      messageListResponseDtoSchema,
      response,
    );
    return validateResponse;
  }

  /**
   * @tags chats
   * @summary Send Message
   * @request POST:/chats/{chatId}/messages
   *
   * @todo 1. ReadableStreamHandler를 상속받아 "./stream-handlers" 경로에 ChatsByChatIdMessagesStreamHandler 클래스를 구현해주세요
   * @see 구현 가이드: https://github.com/dhlab-org/swagger-client-autogen/blob/main/.docs/stream-handler-guide.md
   *
   * @todo 2. 스트리밍 응답은 TanStack Query hook 코드를 자동으로 생성하지 않기 때문에 직접 훅을 구현해서 사용해야 합니다.
   * @see TanStack Query 통합 가이드: https://github.com/dhlab-org/swagger-client-autogen/blob/main/.docs/tanstack-query-stream.md
   */
  async postChatsByChatIdMessages({
    chatId,
    payload,
    callbacks,
  }: TChatsApiRequestParameters["postChatsByChatIdMessages"] & {
    callbacks: ChatsByChatIdMessagesStreamCallbacks;
  }) {
    const validatedPayload = validateSchema(
      messageCreateRequestDtoSchema,
      payload,
    );
    const response = await this.httpClient.requestStream({
      method: "POST",
      url: \`chats/\${chatId}/messages\`,
      body: validatedPayload,
    });

    return new ChatsByChatIdMessagesStreamHandler(response, callbacks);
  }

  /**
   * @tags chats
   * @summary Get Stream Status
   * @request GET:/chats/{chatId}/stream-status
   */
  async getChatsByChatIdStreamStatus({
    chatId,
  }: TChatsApiRequestParameters["getChatsByChatIdStreamStatus"]) {
    const response = await this.httpClient.request<StreamStatusResponseDto>({
      method: "GET",
      url: \`chats/\${chatId}/stream-status\`,
    });

    const validateResponse = validateSchema(
      streamStatusResponseDtoSchema,
      response,
    );
    return validateResponse;
  }
}

export type TChatsApiRequestParameters = {
  getChats: {
    params?: GetChatsQueryParams;
  };
  postChats: {
    payload: ChatCreateRequestDto;
  };
  getChatsByChatId: {
    chatId: number;
  };
  patchChatsByChatId: {
    chatId: number;
    payload: ChatUpdateRequestDto;
  };
  deleteChatsByChatId: {
    chatId: number;
  };
  getChatsByChatIdMessages: {
    chatId: number;
  };
  postChatsByChatIdMessages: {
    chatId: number;
    payload: MessageCreateRequestDto;
  };
  getChatsByChatIdStreamStatus: {
    chatId: number;
  };
};
"
`;

