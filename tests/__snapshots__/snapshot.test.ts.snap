exports[`snapshot tests > TanStack Query code generation > 'ai-chat' - queries, mutations > ai-chat/queries/chats 1`] = `
"import { queryOptions } from "@tanstack/react-query";

import type { GetChatsQueryParams } from "@/shared/api/__generated__/dto";
import type { TChatsApiRequestParameters } from "./index";
import { chatsApi } from "./instance";

export const CHATS_QUERY_KEY = {
  GET_CHATS: (params?: GetChatsQueryParams) => ["chats", params],
  GET_CHATS_CHATID: (chatId: number) => ["chats", chatId],
  GET_CHATS_CHATID_MESSAGES: (chatId: number) => ["chats", chatId, "messages"],
  GET_CHATS_CHATID_STREAM_STATUS: (chatId: number) => [
    "chats",
    chatId,
    "stream-status",
  ],
};

const queries = {
  /**
   * @tags chats
   * @summary Get Chats
   * @request GET:/chats*
   */
  getChats: ({
    params,
    kyInstance,
    options,
  }: TChatsApiRequestParameters["getChats"]) =>
    queryOptions({
      queryKey: CHATS_QUERY_KEY.GET_CHATS(params),
      queryFn: () => chatsApi.getChats({ params, kyInstance, options }),
    }),
  /**
   * @tags chats
   * @summary Get Chat
   * @request GET:/chats/{chatId}*
   */
  getChatsByChatId: ({
    chatId,
    kyInstance,
    options,
  }: TChatsApiRequestParameters["getChatsByChatId"]) =>
    queryOptions({
      queryKey: CHATS_QUERY_KEY.GET_CHATS_CHATID(chatId),
      queryFn: () => chatsApi.getChatsByChatId({ chatId, kyInstance, options }),
      staleTime: Infinity,
    }),
  /**
   * @tags chats
   * @summary Get Messages
   * @request GET:/chats/{chatId}/messages*
   */
  getChatsByChatIdMessages: ({
    chatId,
    kyInstance,
    options,
  }: TChatsApiRequestParameters["getChatsByChatIdMessages"]) =>
    queryOptions({
      queryKey: CHATS_QUERY_KEY.GET_CHATS_CHATID_MESSAGES(chatId),
      queryFn: () =>
        chatsApi.getChatsByChatIdMessages({ chatId, kyInstance, options }),
    }),
  /**
   * @tags chats
   * @summary Get Stream Status
   * @request GET:/chats/{chatId}/stream-status*
   */
  getChatsByChatIdStreamStatus: ({
    chatId,
    kyInstance,
    options,
  }: TChatsApiRequestParameters["getChatsByChatIdStreamStatus"]) =>
    queryOptions({
      queryKey: CHATS_QUERY_KEY.GET_CHATS_CHATID_STREAM_STATUS(chatId),
      queryFn: () =>
        chatsApi.getChatsByChatIdStreamStatus({ chatId, kyInstance, options }),
    }),
};

export { queries as chatsQueries };
"
`;

