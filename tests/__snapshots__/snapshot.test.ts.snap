import { validateSchema } from "@/shared/api/__generated__/utils";

export class AuthApi {
  private readonly instance: KyInstance;

  constructor(instance: KyInstance) {
    this.instance = instance;
  }

  /**
   * @tags auth
   * @summary Sign Up
   * @request POST:/auth/signup
   */
  async postAuthSignup({
    payload,
    kyInstance,
    options,
  }: TAuthApiRequestParameters["postAuthSignup"]) {
    const instance = kyInstance ?? this.instance;
    const validatedPayload = validateSchema(signUpRequestDtoSchema, payload);

    const response = await instance
      .post<AuthResponseDto>(\`auth/signup\`, {
        json: validatedPayload,
        ...options,
      })
      .json();

    const validateResponse = validateSchema(authResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags auth
   * @summary Login
   * @request POST:/auth/login
   */
  async postAuthLogin({
    payload,
    kyInstance,
    options,
  }: TAuthApiRequestParameters["postAuthLogin"]) {
    const instance = kyInstance ?? this.instance;
    const validatedPayload = validateSchema(loginRequestDtoSchema, payload);

    const response = await instance
      .post<AuthResponseDto>(\`auth/login\`, {
        json: validatedPayload,
        ...options,
      })
      .json();

    const validateResponse = validateSchema(authResponseDtoSchema, response);
    return validateResponse;
  }

  /**
   * @tags auth
   * @summary Logout
   * @request POST:/auth/logout
   */
  async postAuthLogout({
    kyInstance,
    options,
  }: TAuthApiRequestParameters["postAuthLogout"] = {}) {
    const instance = kyInstance ?? this.instance;

    const response = await instance
      .post<void>(\`auth/logout\`, {
        ...options,
      })
      .json();

    return response;
  }

  /**
   * @tags auth
   * @summary Refresh Token
   * @request POST:/auth/refresh
   */
  async postAuthRefresh({
    payload,
    kyInstance,
    options,
  }: TAuthApiRequestParameters["postAuthRefresh"]) {
    const instance = kyInstance ?? this.instance;
    const validatedPayload = validateSchema(
      refreshTokenRequestDtoSchema,
      payload,
    );

    const response = await instance
      .post<AuthResponseDto>(\`auth/refresh\`, {
        json: validatedPayload,
        ...options,
      })
      .json();

    const validateResponse = validateSchema(authResponseDtoSchema, response);
    return validateResponse;
  }
}

export type TAuthApiRequestParameters = {
  postAuthSignup: {
    payload: SignUpRequestDto;
    kyInstance?: KyInstance;
    options?: Options;
  };
  postAuthLogin: {
    payload: LoginRequestDto;
    kyInstance?: KyInstance;
    options?: Options;
  };
  postAuthLogout: {
    kyInstance?: KyInstance;
    options?: Options;
  };
  postAuthRefresh: {
    payload: RefreshTokenRequestDto;
    kyInstance?: KyInstance;
    options?: Options;
  };
};
"
`;

