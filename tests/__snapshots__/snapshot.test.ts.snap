import type { usersMutations } from "@/entities/users/__generated__/api/mutations";
// biome-ignore lint/suspicious/noExplicitAny: 타입 제약을 위해 any 사용
type AnyMutationFn = (variables: any) => any;

type MutationFactory = () => {
  mutationFn: AnyMutationFn;
  mutationKey: readonly unknown[];
};

export type MutationMap = Record<string, MutationFactory>;

type ExtractMutationDef<M extends MutationMap, K extends keyof M> = ReturnType<
  M[K]
>;

type ExtractMutationFn<
  M extends MutationMap,
  K extends keyof M,
> = ExtractMutationDef<M, K>["mutationFn"];

type ExtractMutationVariables<
  M extends MutationMap,
  K extends keyof M,
> = Parameters<ExtractMutationFn<M, K>>[0];

type ExtractMutationData<M extends MutationMap, K extends keyof M> = Awaited<
  ReturnType<ExtractMutationFn<M, K>>
>;

export type GlobalMutationEffectMap<M extends MutationMap> = Partial<{
  [K in keyof M]: {
    onSuccess: {
      invalidate: (
        data: ExtractMutationData<M, K>,
