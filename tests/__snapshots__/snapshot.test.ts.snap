exports[`snapshot tests > API code generation > 'ai-chat' - api, apiInstance, dto > ai-chat/dto 1`] = `
"export type StreamStatusDto = "streaming" | "complete" | "error";

export type MessageRoleDto = "user" | "assistant" | "system";

export type SignUpRequestDto = {
  /** @format email */
  email: string;
  /** @minLength 8 */
  password: string;
  name: string;
};

export type LoginRequestDto = {
  /** @format email */
  email: string;
  password: string;
};

export type RefreshTokenRequestDto = {
  refreshToken: string;
};

export type AuthResponseDto = {
  accessToken: string;
  refreshToken: string;
  expiresIn?: number;
  user: UserResponseDto;
};

export type UserResponseDto = {
  /** @format uuid */
  id: string;
  email: string;
  name?: string;
  avatarUrl?: string;
  /** @format date-time */
  createdAt?: string;
};

export type UserUpdateRequestDto = {
  name?: string;
  avatarUrl?: string;
};

export type ChatResponseDto = {
  id: number;
  title: string;
  /** @format date-time */
  createdAt: string;
};

export type ChatDetailResponseDto = {
  id: number;
  title: string;
  /** @format date-time */
  createdAt: string;
  messageCount: number;
};

export type ChatCreateRequestDto = {
  title: string;
  /** @default "gpt-4" */
  model?: string;
};

export type ChatUpdateRequestDto = {
  title: string;
};

export type ChatListResponseDto = {
  items: ChatResponseDto[];
  nextCursor: string | null;
};

export type MessageListResponseDto = {
  data: MessageResponseDto[];
};

export type MessageResponseDto = {
  id: number;
  chatId: number;
  /** @format date-time */
  createdAt: string;
  role: MessageRoleDto;
  content: string;
};

export type MessageCreateRequestDto = {
  content: string;
  role?: MessageRoleDto;
};

export type StreamStatusResponseDto = {
  status: StreamStatusDto;
};

export type ErrorResponseDto = {
  message: string;
  code?: string;
};

export type GetChatsQueryParams = {
  cursor?: string | null;
  /** @default 10 */
  size?: number;
};
"
`;

