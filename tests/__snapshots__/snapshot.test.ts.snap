export const AUTH_MUTATION_KEY = {
  POST_AUTH_SIGNUP: ["auth", "signup"] as const,
  POST_AUTH_LOGIN: ["auth", "login"] as const,
  POST_AUTH_LOGOUT: ["auth", "logout"] as const,
  POST_AUTH_REFRESH: ["auth", "refresh"] as const,
} as const;

const mutations = {
  postAuthSignup: () => ({
    mutationFn: ({ payload }: TAuthApiRequestParameters["postAuthSignup"]) => {
      return authApi.postAuthSignup({ payload });
    },
    mutationKey: AUTH_MUTATION_KEY.POST_AUTH_SIGNUP,
    meta: {
      mutationFnName: "postAuthSignup",
    },
  }),
  postAuthLogin: () => ({
    mutationFn: ({ payload }: TAuthApiRequestParameters["postAuthLogin"]) => {
      return authApi.postAuthLogin({ payload });
    },
